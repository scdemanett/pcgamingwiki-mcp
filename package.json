{
  "name": "pcgamingwiki-mcp",
  "version": "0.0.0",
  "description": "Read-only MCP server for PCGamingWiki data (code MIT; wiki data CC BY-NC-SA 3.0)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "bin": {
    "pcgamingwiki-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scdemanett/pcgamingwiki-mcp.git"
  },
  "keywords": [
    "mcp",
    "pcgamingwiki",
    "model-context-protocol",
    "games"
  ]
}
